<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kalkura">

        <!-- 1. SPLASH ACTIVITY (Dijadikan Launcher Utama) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. HOME ACTIVITY -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <!-- 3. PENGATURAN ACTIVITY -->
        <activity
            android:name=".PengaturanActivity"
            android:exported="false" />

        <!-- 4. HITUNG ACTIVITY -->
        <activity
            android:name=".HitungActivity"
            android:exported="false" />

        <!-- 5. DETAIL ACTIVITY -->
        <activity
            android:name=".DetailActivity"
            android:exported="false" />

        <!-- 6. SIMULASI ACTIVITY -->
        <activity
            android:name=".SimulasiActivity"
            android:exported="false" />

        <!-- 7. RIWAYAT ACTIVITY -->
        <activity
            android:name=".RiwayatActivity"
            android:exported="false" />

    </application>

</manifest>